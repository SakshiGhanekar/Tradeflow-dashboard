{
  "name": "arham-trades-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend",
    "start:backend": "node backend/src/app.js",
    "start:frontend": "vite --cwd frontend",
    "start:mock": "node mock-bse.js",
    "start:all": "concurrently \"npm run start:backend\" \"npm run start:frontend\" \"npm run start:mock\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "mock": "node mock-bse.js",
    "test": "node --test backend",
    "test:backend": "node --test backend",
    "lint": "echo \"No linter configured\" && exit 0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongoose": "^8.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "supertest": "^7.0.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
